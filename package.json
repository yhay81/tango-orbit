{
  "name": "tango-orbit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "oxlint --fix . && oxfmt --write . && tsc --noEmit",
    "test": "vp test --run --config vitest.config.ts",
    "test:watch": "vp test --config vitest.config.ts",
    "dictionary:update": "node scripts/update-dictionary.mjs",
    "release:check": "pwsh -NoLogo -NoProfile -File ops/validate-product.ps1",
    "metrics": "pwsh -NoLogo -NoProfile -File ops/product-metrics.ps1",
    "indexnow": "pwsh -NoLogo -NoProfile -File ops/submit-indexnow.ps1 -BaseUrl https://tango-orbit.yhay81.com",
    "deploy": "npm run release:check && npm run check && npm test && npm run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "4.12.32"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "5.20260726.1",
    "@types/node": "24.13.3",
    "@voidzero-dev/vite-plus-core": "0.2.6",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
    "vite-plus": "0.2.6",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "packageManager": "npm@11.16.0"
}
