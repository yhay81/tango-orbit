{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tango-orbit",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/privacy", "/sources", "/api/*", "/healthz"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tango-orbit",
      "database_id": "85d0364a-7545-4fa3-a42c-bb79a7b95e45",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "27260715",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["27 4 * * *"],
  },
}
